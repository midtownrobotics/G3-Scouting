<html>
    <head>
        <link rel="stylesheet" href="/libs/bootstrap.min.css">
        <link rel="stylesheet" href="/libs/bootstrap-icons-1.11.3/font/bootstrap-icons.min.css">
        <link rel="icon" type="image/png" href="/g3.png">
        <link rel="stylesheet" href="/css/global.css">
        <script src="/libs/jquery-3.7.1.min.js"></script>
        <script>var exports = {};</script>
        <script type="module" src="/js/global.js"></script>
        <title>G3 Scouting!</title>
    </head>

    <%- include('partials/nav') %>

    <div id="forms">
        <h3>Select a Form</h3>
        <% if (message) { %>
            <h5 style="font-style: italic;"><%= message %></h5>
        <% } %>
        <% for (let i=0; i < forms.length; i++) { 
            if (i == 0) { %>
                <a href="/forms?form=<%=forms[i].id%>" style="font-size: 35px;">> <%=forms[i].title%> <</a><br>
            <% } else { %>
                <a href="/forms?form=<%=forms[i].id%>">> <%=forms[i].title%> <</a><br>
            <% } %>
        <% } %>
    </div>
</html>

<script>$("#nav-forms").addClass("active")</script>

<style>

    #forms {
        margin: 20px;
        text-align:center;
    }

    #forms h1 {
        font-size: 60px;
    }

    #forms h3 {
        font-size: 45px;
    }

    #forms   a {
        font-size: 30px;
    }

